{
    "manifest_version": 3,
    "name": "__MSG_addonName__",
    "description": "__MSG_addonDescription__",
    "version": "0.1",
    "author": "__MSG_addonAuthor__",
    "browser_specific_settings": {
        "gecko": {
            "id": "aveleshko.set-email-font@addons.thunderbird.net",
            "strict_min_version": "140.0"
        }
    },
    "permissions": [
        "compose",
        "scripting",
        "storage"
    ],
    "icons": {
        "64": "images/font-64px.png",
        "32": "images/font-32px.png",
        "24": "images/font-24px.png",
        "16": "images/font-16px.png"
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": false
    },
    "background": {
        "scripts": ["background.js"],
        "type": "module"
    },
    "default_locale": "en"
}